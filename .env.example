# Copy to apps/web/.env.local and apps/admin/.env.local — NEVER commit the real files.
# Supabase (Project Settings → API). Only the PUBLIC (anon / publishable) key belongs here.
# Never put the service_role / secret key in either app: nothing needs it, and it bypasses all security rules.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Public URLs — change when you get a domain (no code edits needed). Use https:// in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Email alerts for new contact-form messages (website app only). Optional: leave the key empty to turn alerts off —
# messages are always saved in the admin Inbox either way. Get a key at resend.com → API Keys ("Sending access").
RESEND_API_KEY=
# Where alerts go (up to 3, comma-separated). Before your domain is verified in Resend, this MUST be the email
# your Resend account was created with.
CONTACT_NOTIFY_EMAIL=you@example.com
# Sender. Leave empty to use Resend's test sender (onboarding@resend.dev). After verifying your domain in Resend,
# use e.g.: Website <hello@yourdomain.com>
RESEND_FROM=

# Salts for hashing visitor IPs (rate limits only; raw IPs are never stored). Use long random strings in
# production (e.g. `openssl rand -hex 32`) — without a secret salt, hashed IPs are easy to reverse.
# website app:
CONTACT_HASH_SALT=change-me
# admin app (sign-in throttle):
AUTH_HASH_SALT=change-me
